{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "DOCS_SITE_URL"
      ],
      "passThroughEnv": [
        "DATABASE_*",
        "NEXTAUTH_*",
        "GOOGLE_CLIENT_*",
        "ADMIN_EMAILS",
        "AUTH_DEV_LOGIN",
        "SMTP_URL",
        "MAIL_FROM",
        "GITHUB_TOKEN",
        "GITHUB_LOOKUP",
        "LTI_*",
        "METRICS_TOKEN",
        "PROXY_SECRET",
        "CLIENT_IP_HEADER",
        "RESEND_*",
        "CRON_SECRET"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
