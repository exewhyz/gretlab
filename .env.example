# Copy to .env at the repo root. Used by the runner and the database scripts, and in
# production by docker-compose.prod.yml, which passes the web app's settings from here
# (the full list of web settings is in apps/web/.env.example and README.md › Settings).
DATABASE_URL=postgres://gretlab:gretlab_dev_only@127.0.0.1:5433/gretlab

# Production must leave this as runsc. See "Sandbox rules" in AGENTS.md.
SANDBOX_RUNTIME=runsc
# Local development without gVisor only. Refused when NODE_ENV=production.
# SANDBOX_RUNTIME=runc
# SANDBOX_ALLOW_INSECURE_RUNC=true

# Optional. Default: one slot per core, at most 8. More machines beat more slots: docs/scaling.md
# RUNNER_CONCURRENCY=8
# Memory this runner may promise to jobs. Default: all but 1 GB.
# RUNNER_MEMORY_MB=8192

# Set by deploy/runner-setup.sh (don't edit by hand): an organization's own judge
# (RUNNER_POOL=<organization address>; empty: shared), the dashboard machine it runs on, and the
# commit it was set up from.
# RUNNER_POOL=
# RUNNER_MACHINE=
# RUNNER_VERSION=
# How often an idle judge checks the queue in case a wake-up was missed (default 10 s), and how
# long a claimed job is held between heartbeats (default 30 s).
# RUNNER_POLL_MS=10000
# RUNNER_LEASE_MS=30000
# The judge's LISTEN session needs a direct address or a session pooler; set this when
# DATABASE_URL is a transaction pooler.
# DATABASE_DIRECT_URL=

# The background-jobs worker (apps/worker; optional, for a server that stays on): the site it
# asks to run jobs, the same CRON_SECRET as the site, and DATABASE_URL to listen for new jobs.
# SITE_URL=https://gretlab.grettech.com
# WORKER_IDLE_MS=60000

# Demo data (pnpm --filter @workspace/db demo): the password every demo account shares. It must
# pass the app's password rules; never write the real one in a file that's committed.
# DEMO_PASSWORD=

# The docs site's address (apps/docs), for a preview or local build; default the live one.
# DOCS_SITE_URL=https://docs.gretlab.grettech.com

# Shared by Caddy and the web app so the app can trust visitors' network addresses (lab
# exams limited to a network). At least 16 random characters: openssl rand -hex 24
# Without it, exams can't be limited to a network.
# PROXY_SECRET=

# Optional email for notifications: smtp://user:password@host:587 (smtps:// for 465).
# Queued and sent in batches with retries (features/notifications/outbox.ts). Either
# RESEND_API_KEY (Resend's API, batches of 100) or SMTP_URL (any mail server). MAIL_FROM must
# be on a domain the provider has verified.
# RESEND_API_KEY=
# SMTP_URL=
# MAIL_FROM=GretLab <no-reply@your-college.edu>
# Lets a scheduler send big batches and retries: POST /api/cron/outbox with
# "Authorization: Bearer <CRON_SECRET>". At least 16 characters: openssl rand -hex 24
# CRON_SECRET=

# GitHub projects: a token raises GitHub's rate limit for pinning handed-in repositories
# to their commit. GITHUB_LOOKUP=off skips the lookup (tests, offline servers).
# GITHUB_TOKEN=
# GITHUB_LOOKUP=off

# LTI 1.3: GretLab's signing key (PEM, \n for newlines). Without it, a key is made on first
# use and kept in the database. LTI_ALLOW_HTTP=true lets LMS addresses be http (local tests only).
# LTI_PRIVATE_KEY=
# LTI_KEY_ID=
# LTI_ALLOW_HTTP=true
