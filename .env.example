# Copy to .env at the repo root; used by the runner and the database scripts.
DATABASE_URL=postgres://gretlab:gretlab_dev_only@127.0.0.1:5433/gretlab

# Production must leave this as runsc. See "Sandbox rules" in AGENTS.md.
SANDBOX_RUNTIME=runsc
# Local development without gVisor only. Refused when NODE_ENV=production.
# SANDBOX_RUNTIME=runc
# SANDBOX_ALLOW_INSECURE_RUNC=true

# Optional. Default: one slot per core, at most 8. More machines beat more slots: docs/scaling.md
# RUNNER_CONCURRENCY=8
# Memory this runner may promise to jobs. Default: all but 1 GB.
# RUNNER_MEMORY_MB=8192

# Proxies in front of the web app that append X-Forwarded-For (Caddy in deploy/). Used for
# lab exams limited to a network. Default 1; 0 when nothing sits in front.
# TRUSTED_PROXIES=1
