# Copy to .env at the repo root; used by the runner and the database scripts.
DATABASE_URL=postgres://gretlab:gretlab_dev_only@127.0.0.1:5433/gretlab

# Production must leave this as runsc. See "Sandbox rules" in AGENTS.md.
SANDBOX_RUNTIME=runsc
# Local development without gVisor only. Refused when NODE_ENV=production.
# SANDBOX_RUNTIME=runc
# SANDBOX_ALLOW_INSECURE_RUNC=true

# Optional. Default: one slot per core, at most 8. More machines beat more slots: docs/scaling.md
# RUNNER_CONCURRENCY=8
# Memory this runner may promise to jobs. Default: all but 1 GB.
# RUNNER_MEMORY_MB=8192

# Shared by Caddy and the web app so the app can trust visitors' network addresses (lab
# exams limited to a network). At least 16 random characters: openssl rand -hex 24
# Without it, exams can't be limited to a network.
# PROXY_SECRET=

# Optional email for notifications: smtp://user:password@host:587 (smtps:// for 465).
# SMTP_URL=
# MAIL_FROM=GretLab <no-reply@your-college.edu>

# GitHub projects: a token raises GitHub's rate limit for pinning handed-in repositories
# to their commit. GITHUB_LOOKUP=off skips the lookup (tests, offline servers).
# GITHUB_TOKEN=
# GITHUB_LOOKUP=off

# LTI 1.3: Gretlab's signing key (PEM, \n for newlines). Without it, a key is made on first
# use and kept in the database. LTI_ALLOW_HTTP=true lets LMS addresses be http (local tests only).
# LTI_PRIVATE_KEY=
# LTI_KEY_ID=
# LTI_ALLOW_HTTP=true
