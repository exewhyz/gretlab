---
/*
 * The top of every page (replacing Starlight's PageTitle): where the page sits (breadcrumbs
 * from the sidebar), its title and one-line description, a "Copy page" button that copies
 * its Markdown, and, on a feature page, the "At a glance" cards from its frontmatter.
 */
import Glance from "./Glance.astro"
import Icon from "./Icon.astro"

type Entry = {
  type: "link" | "group"
  label: string
  href?: string
  isCurrent?: boolean
  entries?: Entry[]
}
const route = Astro.locals.starlightRoute
const data = route.entry.data as typeof route.entry.data & {
  glance?: Parameters<typeof Glance>[0]["glance"]
}

// The groups above the current page in the sidebar.
function trail(entries: Entry[], path: string[] = []): string[] | null {
  for (const e of entries) {
    if (e.type === "link" && e.isCurrent) return path
    if (e.type === "group" && e.entries) {
      const found = trail(e.entries, [...path, e.label])
      if (found) return found
    }
  }
  return null
}
const crumbs = trail(route.sidebar as Entry[]) ?? []
const markdown = `# ${data.title}\n\n${data.description ? `${data.description}\n\n` : ""}${route.entry.body ?? ""}`
---

<div class="gl-title">
  {
    crumbs.length > 0 && (
      <nav aria-label="Breadcrumbs" class="crumbs">
        <ol>
          {crumbs.map((c) => (
            <li>
              {c}
              <Icon name="caret-right" size={12} />
            </li>
          ))}
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>
    )
  }
  <div class="title-row">
    <h1 id="_top">{data.title}</h1>
    {
      route.entry.body && (
        <button type="button" class="copy" data-markdown={markdown}>
          <Icon name="copy" size={15} />
          <span>Copy page</span>
        </button>
      )
    }
  </div>
  {data.description && <p class="lead">{data.description}</p>}
  {data.glance && <Glance glance={data.glance} />}
</div>

<script>
  // Copies the page as Markdown, and says so on the button for a moment.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".gl-title .copy")) {
    button.addEventListener("click", async () => {
      const label = button.querySelector("span")!
      try {
        await navigator.clipboard.writeText(button.dataset.markdown ?? "")
        label.textContent = "Copied"
      } catch {
        label.textContent = "Couldn't copy"
      }
      setTimeout(() => (label.textContent = "Copy page"), 1800)
    })
  }
</script>

<style>
  .gl-title {
    margin-top: 1rem;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .crumbs [aria-current="page"] {
    color: var(--sl-color-white);
  }
  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  h1 {
    margin: 0;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--gl-card);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .copy:hover {
    background: var(--sl-color-gray-6);
  }
  .copy:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 2px;
  }
  .lead {
    margin: 0.75rem 0 0;
    max-width: 42rem;
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  @media (max-width: 40rem) {
    .copy span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
