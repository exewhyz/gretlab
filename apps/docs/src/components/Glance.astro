---
/*
 * "At a glance" on a feature page, from its frontmatter `glance`: who uses it, where it is
 * in the app, and the permissions and module behind it.
 * Permission labels and module details come from the app's own lists (data/catalog).
 */
import Icon from "./Icon.astro"
import {
  MODULES,
  listKinds,
  moduleKinds,
  permissionInfo,
} from "../data/catalog"

interface Props {
  glance: {
    who?: { role: string; note?: string }[]
    where?: { path?: string; menu?: string }
    permissions?: string[]
    module?: string
  }
}
const { glance } = Astro.props
const mod = glance.module
  ? {
      ...(MODULES as Record<string, { label: string; description: string }>)[glance.module]!,
      ...moduleKinds(glance.module),
    }
  : null
---

<section class="glance" aria-labelledby="at-a-glance">
  <h2 id="at-a-glance" class="glance-title">At a glance</h2>
  <div class="glance-grid">
    {
      glance.who && (
        <div class="glance-card">
          <h3>
            <Icon name="users" /> Who uses it
          </h3>
          <ul class="who">
            {glance.who.map((w) => (
              <li>
                <span class="role">
                  <Icon name="user" size={13} />
                  {w.role}
                </span>
                {w.note && <span class="note">{w.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      glance.where && (
        <div class="glance-card">
          <h3>
            <Icon name="compass" /> Where to find it
          </h3>
          {glance.where.path && (
            <p>
              <code class="path">{glance.where.path}</code>
            </p>
          )}
          {glance.where.menu && <p class="menu">{glance.where.menu}</p>}
        </div>
      )
    }
    {
      glance.permissions && (
        <div class="glance-card">
          <h3>
            <Icon name="key" /> Permissions
          </h3>
          <ul class="perms">
            {glance.permissions.map((key) => {
              const info = permissionInfo(key)!
              return (
                <li>
                  <span class="perm-label">{info.label}</span>
                  <code>{key}</code>
                </li>
              )
            })}
          </ul>
        </div>
      )
    }
    {
      mod && (
        <div class="glance-card">
          <h3>
            <Icon name="puzzle-piece" /> Module
          </h3>
          <p>
            <strong>{mod.label}</strong>. {mod.description}
          </p>
          <p class="note">
            {mod.onByDefault.length > 0
              ? `On from the start for ${listKinds(mod.onByDefault)}`
              : "Off until an organization switches it on"}
            {mod.can.length > mod.onByDefault.length &&
              `; available to ${listKinds(mod.can.filter((k) => !mod.onByDefault.includes(k)))}`}
            . Settings › Modules switches it.
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .glance {
    margin-top: 2rem;
  }
  .glance-title {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 0.75rem;
  }
  .glance-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .glance-card {
    background: var(--gl-card);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    padding: 1rem 1.125rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .glance-card h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.625rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .glance-card p {
    margin: 0.25rem 0 0;
    color: var(--sl-color-gray-2);
  }
  .glance-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.375rem;
  }
  .who li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }
  .role {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 9999px;
    padding: 0.0625rem 0.5rem;
    color: var(--sl-color-white);
    font-weight: 500;
    background: var(--sl-color-gray-6);
  }
  .note {
    color: var(--sl-color-gray-3);
  }
  .path {
    font-size: var(--sl-text-xs);
  }
  .menu {
    color: var(--sl-color-white);
  }
  .perms li {
    display: grid;
    gap: 0.0625rem;
  }
  .perm-label {
    color: var(--sl-color-white);
  }
  .perms code {
    justify-self: start;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
