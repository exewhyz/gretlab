---
/*
 * A Phosphor icon (the app's icon set), inlined so it takes the text colour. `name` is the
 * file name in @phosphor-icons/core/assets/regular, such as "users" or "check-square".
 */
const icons = import.meta.glob<string>(
  "/node_modules/@phosphor-icons/core/assets/regular/*.svg",
  { query: "?raw", import: "default", eager: true }
)

interface Props {
  name: string
  size?: number
  label?: string
}
const { name, size = 18, label } = Astro.props
const svg = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`]
if (!svg) throw new Error(`No Phosphor icon called "${name}"`)
const sized = svg.replace("<svg ", `<svg width="${size}" height="${size}" fill="currentColor" `)
---

<span
  class="gl-icon"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={sized}
/>

<style>
  .gl-icon {
    display: inline-flex;
    flex: none;
    line-height: 0;
  }
</style>
