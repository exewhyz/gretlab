# Copy to .env.local, or set these on your host.

# ---------- Database ----------
DATABASE_URL=postgres://gretlab:gretlab_dev_only@127.0.0.1:5433/gretlab

# ---------- Sign in (read when the site runs) ----------
# The site's public address. In development: http://localhost:3000
NEXTAUTH_URL=

# Signs the session cookie. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated accounts that become admins on sign-in. Everyone else is managed in
# the dashboard. This is how the first admin exists.
ADMIN_EMAILS=

# Local development without Google. Ignored in production builds.
# AUTH_DEV_LOGIN=true

# Token for GET /api/metrics. Leave empty to keep metrics off.
# METRICS_TOKEN=

# Behind a connection pooler (PgBouncer, as serverless hosts need): turn off prepared
# statements, and keep each instance's own pool small.
# DATABASE_PREPARE=false
# DATABASE_POOL=10

# ---------- Lab exams limited to networks ----------
# Shared with Caddy so the app trusts visitors' addresses. At least 16 random characters:
# openssl rand -hex 24. Without it, exams can't be limited to a network (docs/deploy-exams.md).
# PROXY_SECRET=
# Or, on Vercel, nothing (its edge vouches). On another host, the header it puts the visitor's
# address in (cf-connecting-ip, x-nf-client-connection-ip, fly-client-ip). Only if visitors
# can't reach the app around that host (docs/deploy-exams.md).
# CLIENT_IP_HEADER=

# ---------- Optional features ----------
# Email notifications: smtp://user:password@host:587 (smtps:// for 465). Without it, in-app only.
# Queued and sent in batches with retries (features/notifications/outbox.ts). Either
# RESEND_API_KEY (Resend's API, batches of 100) or SMTP_URL (any mail server). MAIL_FROM must
# be on a domain the provider has verified.
# RESEND_API_KEY=
# SMTP_URL=
# MAIL_FROM=GretLab <no-reply@your-college.edu>
# Lets a scheduler send big batches and retries: POST /api/cron/outbox with
# "Authorization: Bearer <CRON_SECRET>". At least 16 characters: openssl rand -hex 24
# CRON_SECRET=

# GitHub projects: a token raises GitHub's rate limit (60 lookups an hour without one) for
# pinning handed-in repositories to their commit. GITHUB_LOOKUP=off skips lookups (tests).
# GITHUB_TOKEN=
# GITHUB_LOOKUP=off

# LTI 1.3: a fixed signing key (PEM, one line with \n for newlines) and its id. Without them a
# key is made on first use and kept in the database. LTI_ALLOW_HTTP=true lets LMS addresses be
# http, for local tests only.
# LTI_PRIVATE_KEY=
# LTI_KEY_ID=
# LTI_ALLOW_HTTP=true

# ---------- Ads (read at build time, so rebuild after changing) ----------
# With these empty the site runs with no ads and loads no ad scripts.

# From AdSense > Account > Account information, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# From AdSense > Ads > By ad unit > Display ads. Each placement is off until its id is set.
# Create the sidebar unit as Fixed, 200 x 200. Create the other two as Responsive.
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_PROBLEM_END=
NEXT_PUBLIC_ADSENSE_SLOT_PAGE_END=
