# Copy to .env.local, or set these on your host.

# ---------- Database ----------
DATABASE_URL=postgres://gretlab:gretlab_dev_only@127.0.0.1:5433/gretlab

# ---------- Sign in (read when the site runs) ----------
# The site's public address. In development: http://localhost:3000
NEXTAUTH_URL=

# Signs the session cookie. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated accounts that become admins on sign-in. Everyone else is managed in
# the dashboard. This is how the first admin exists.
ADMIN_EMAILS=

# Local development without Google. Ignored in production builds.
# AUTH_DEV_LOGIN=true

# Token for GET /api/metrics. Leave empty to keep metrics off.
# METRICS_TOKEN=

# ---------- Ads (read at build time, so rebuild after changing) ----------
# With these empty the site runs with no ads and loads no ad scripts.

# From AdSense > Account > Account information, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# From AdSense > Ads > By ad unit > Display ads. Each placement is off until its id is set.
# Create the sidebar unit as Fixed, 200 x 200. Create the other two as Responsive.
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_PROBLEM_END=
NEXT_PUBLIC_ADSENSE_SLOT_PAGE_END=
